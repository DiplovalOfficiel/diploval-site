    "legal": "CR-08 transversal, distinction entre allégation, fait, décision et qualification ; aucun indice ne qualifie juridiquement une guerre.",
    "confidence": "Confiance par axe distincte de l'indice ; base limitée impose réserve et corroboration, faible indice non acceptable sans examen suffisant.",
    "trend": "CR-09 distinct : amélioration, stabilité, détérioration ou indétermination, comparer des périodes et périmètres compatibles."
  },
  "review_policy": {
    "status": "proposee",
    "note": "Priorité interne de revue uniquement, jamais code public. Revue immédiate si indice 4 ou signal urgent crédible, même lorsque d'autres données manquent ou sont invalides ; urgence opérationnelle à traiter par organismes compétents.",
    "precedence": [
      "réexamen immédiat",
      "réexamen prioritaire",
      "instruction renforcée",
      "instruction rapprochée",
      "suivi ordinaire"
    ],
    "existing_codes": "Aucune simulation ne modifie un niveau validé ; une baisse comme une hausse nécessite décision humaine."
  },
  "validator_source": "function evaluate(profile){\n const errors=[],warnings=[];\n for(const axis of [\"G\",\"U\",\"E\"]){\n  const x=profile[axis];\n  if(!x||!Object.hasOwn(x,\"value\")){errors.push(axis+\":manquant\");continue}\n  if(x.value!==null&&(!Number.isInteger(x.value)||x.value<0||x.value>4))errors.push(axis+\":hors_echelle\");\n  if(![\"suffisante\",\"limitee\",\"absente\"].includes(x.basis))errors.push(axis+\":base_invalide\");\n  if(![\"forte\",\"moyenne\",\"faible\",\"indeterminee\"].includes(x.confidence))errors.push(axis+\":confiance_invalide\");\n  if(![\"actuelle\",\"ancienne\",\"inconnue\"].includes(x.freshness))errors.push(axis+\":fraicheur_invalide\");\n  if(x.value!==null&&(x.basis===\"absente\"||x.freshness!==\"actuelle\"||x.confidence===\"indeterminee\"))errors.push(axis+\":indice_non_etaye\");\n  if((x.value===0||x.value===1)&&(x.basis!==\"suffisante\"||![\"forte\",\"moyenne\"].includes(x.confidence)))errors.push(axis+\":faible_risque_non_etaye\");\n  if(x.value!==null&&x.value>=2&&(x.basis===\"limitee\"||x.confidence===\"faible\"))warnings.push(axis+\":appreciation_provisoire_a_corroborer\");\n  if(x.value===null)warnings.push(axis+\":indetermine\");\n  if(typeof x.reason!==\"string\"||!x.reason.trim())errors.push(axis+\":motif_manquant\");\n }\n if(![null,\"1\",\"2\",\"3\"].includes(profile.existing_code))errors.push(\"code_existant_invalide\");\n if(typeof profile.scope!==\"string\"||!profile.scope.trim())errors.push(\"perimetre_manquant\");\n if(typeof profile.horizon!==\"string\"||!profile.horizon.trim())errors.push(\"horizon_manquant\");\n const values=[\"G\",\"U\",\"E\"].map(k=>profile[k]?.value);\n const urgent=profile.credible_urgent_signal===true||values.includes(4);\n const priority=urgent?\"reexamen_immediat\":values.includes(3)?\"reexamen_prioritaire\":warnings.length||values.includes(null)?\"instruction_renforcee\":values.includes(2)?\"instruction_rapprochee\":\"suivi_ordinaire\";\n return {valid:errors.length===0,errors,warnings,priority:errors.length?(urgent?\"reexamen_immediat_donnees_invalides\":\"corriger_donnees\"):priority,existing_code:profile.existing_code,proposed_code:null,publication_allowed:false};\n}",
